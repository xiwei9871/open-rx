# EasyRS dev environment — copy to .env (gitignored). Never commit real values.
POSTGRES_ADMIN_PASSWORD=dev_admin_pw_change_me
POSTGRES_APP_PASSWORD=dev_app_pw_change_me
MINIO_ROOT_USER=easyrs_dev
MINIO_ROOT_PASSWORD=dev_minio_pw_change_me

# API runtime
DATABASE_URL=postgresql+asyncpg://easyrs_app:dev_app_pw_change_me@localhost:55432/easyrs
DATABASE_ADMIN_URL=postgresql+asyncpg://easyrs_admin:dev_admin_pw_change_me@localhost:55432/easyrs
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=easyrs_dev
S3_SECRET_KEY=dev_minio_pw_change_me
S3_BUCKET=easyrs-assets-dev

SESSION_SECRET=dev_session_secret_change_me_32bytes!!
# REQUIRED in prod (base64 Fernet key, 32 bytes). Dev/test may omit — HKDF-
# derived from SESSION_SECRET instead. Generate: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
ENV=dev
# dev-only: the migrate compose service runs `python -m app.seed` when true.
# ENV=prod refuses to boot with these dev values and refuses seed entirely.
SEED_SYNTHETIC=true
