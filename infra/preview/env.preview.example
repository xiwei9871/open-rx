# EasyRS Private Preview — server-local secrets template.
# Copy to infra/preview/.env.preview on the deploy host, chmod 600, fill in.
# NEVER commit a filled .env.preview — it is gitignored via .env.*

# --- entry points ----------------------------------------------------------
# LAN IP the ingress reaches (this host's private IP, e.g. 192.168.3.185).
PREVIEW_BIND_IP=192.168.3.185
PREVIEW_WEB_PORT=5190
PREVIEW_S3_PORT=5191
# Image tag for this release — bump per deploy for rollback (e.g. v0.1.1).
PREVIEW_IMAGE_TAG=v0.1.0

# --- postgres --------------------------------------------------------------
POSTGRES_ADMIN_PASSWORD=<generate: openssl rand -base64 24>
POSTGRES_APP_PASSWORD=<generate: openssl rand -base64 24>

# --- redis -----------------------------------------------------------------
REDIS_PASSWORD=<generate: openssl rand -base64 24>

# --- object storage ---------------------------------------------------------
S3_ACCESS_KEY=<generate: openssl rand -hex 16>
S3_SECRET_KEY=<generate: openssl rand -base64 24>
S3_BUCKET=easyrs-preview-assets
# Browser-dialed presigned endpoint — the PUBLIC https ingress for rustfs.
# During LAN-only bring-up: http://192.168.3.185:5191
# After HTTPS route exists: https://<s3-host>
S3_PUBLIC_ENDPOINT_URL=http://192.168.3.185:5191

# --- api security ------------------------------------------------------------
# openssl rand -base64 48
SESSION_SECRET=<generate>
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=<generate>
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://192.168.3.185:5190
# Align with the ingress upload ceiling; lanproxy/proxy may cap lower than the
# app default of 200MB — set to the verified value, UI and tests must agree.
UPLOAD_MAX_BYTES=104857600

# --- controlled demo seed ----------------------------------------------------
# Set true ONLY while running the demo-seed job, then revert.
PREVIEW_DEMO_SEED=false
# Shared-secret token the seed CLI must be given explicitly.
PREVIEW_DEMO_TOKEN=<generate: openssl rand -hex 16>
# JSON account spec — passwords live only here, never in git.
PREVIEW_DEMO_ACCOUNTS=[]
